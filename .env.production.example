# Google PageSpeed Insights API v5. Leave empty to keep the audit check in skipped state.
GOOGLE_PAGESPEED_API_KEY=
# OAuth: callback origin must match the registered Yandex Redirect URI.
WEBDIAG_ACCOUNT_PUBLIC_ORIGIN=https://app.webdiag.ru
WEBDIAG_YANDEX_CLIENT_ID=
WEBDIAG_YANDEX_CLIENT_SECRET=
# Distinct private API/web token for legacy OAuth account recovery via email.
WEBDIAG_ACCOUNT_INTERNAL_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=no-replay@webdiag.ru
LAVA_API_KEY=
LAVA_WEBHOOK_SECRET=
LAVA_OFFER_ID=
NEVTAN_SMTP_HOST=smtp.nevtan.com
NEVTAN_SMTP_PORT=465
NEVTAN_SMTP_USER=support@webdiag.ru
NEVTAN_SMTP_PASS=
CONTACT_RECIPIENT_EMAIL=
# Optional AI polling in the core scheduler; requires all three secrets below.
WEBDIAG_AI_RUNTIME_ENABLED=false
WEBDIAG_AI_INTERNAL_TOKEN=
WEBDIAG_AI_SAFETY_IDENTIFIER_SECRET=
AI_GATEWAY_API_KEY=
WEBDIAG_MONITORING_INTERNAL_TOKEN=
WEBDIAG_CRAWLER_INTERNAL_TOKEN=
WEBDIAG_CRAWLER_PAGE_LIMIT=100
WEBDIAG_CRAWLER_DEADLINE_SECONDS=240
WEBDIAG_CRAWLER_LEASE_SECONDS=300
WEBDIAG_CRAWLER_WORKER_TIMEOUT_SECONDS=270
WEBDIAG_CRAWLER_ACTIVE_JOB_LIMIT_PER_USER=2
WEBDIAG_CRAWLER_ACTIVE_JOB_LIMIT_GLOBAL=25
WEBDIAG_ACCOUNT_REGISTRATION_REQUEST_LIMIT=30
WEBDIAG_ACCOUNT_REGISTRATION_WINDOW_SECONDS=60
WEBDIAG_ACCOUNT_REGISTRATION_CONCURRENCY_LIMIT=2
WEBDIAG_ACCOUNT_REGISTRATION_LEASE_SECONDS=30
