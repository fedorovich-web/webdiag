WEBDIAG_ACCOUNT_DATABASE_PATH=.webdiag/accounts.sqlite3
WEBDIAG_ACCOUNT_SESSION_TTL_SECONDS=2592000
WEBDIAG_ACCOUNT_ACTIVE_SESSION_LIMIT=10
WEBDIAG_ACCOUNT_COOKIE_SECURE=false
WEBDIAG_ACCOUNT_SCRYPT_N=16384
WEBDIAG_ACCOUNT_SCRYPT_R=8
WEBDIAG_ACCOUNT_SCRYPT_P=1
WEBDIAG_ACCOUNT_SCRYPT_DKLEN=32
WEBDIAG_API_INTERNAL_URL=http://127.0.0.1:8000
WEBDIAG_MONITORING_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
WEBDIAG_MONITORING_SCHEDULER_INTERVAL_SECONDS=60
